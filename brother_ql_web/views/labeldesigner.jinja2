{% extends "base.jinja2" %}

{% block page_title %}
    {{ title }}
{% endblock %}

{% block jumbotron %}
    <h1>{{ website.page_title }}</h1>
    <p>{{ website.page_headline }}</p>
{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-md-4">
            <fieldset class="form-group">
                <div class="card-group" id="accordion">
                    <div class="col-md-12">
                        <div class="card">
                            <div class="card-header" id="headingPrinter">
                                <h4 class="card-title">
                                    <button class="btn" data-bs-toggle="collapse" data-bs-target="#collapsePrinter" aria-expanded="true" aria-controls="collapsePrinter">
                                        <span class="bi-printer-fill" aria-hidden="true"></span> Printer
                                    </button>
                                </h4>
                            </div>
                            <div id="collapsePrinter" class="collapse show" aria-labelledby="headingPrinter" data-parent="#accordion">
                                <div class="chooser card-body">
                                    <label for="printerSelect">Printer:</label>
                                    <select class="form-control" id="printerSelect" onChange="onPrinterChanged()">
                                        {% for printer in printers %}<option value="{{ printer.id }}">{{ printer.name }}</option>{% endfor %}
                                    </select>
                                    <div id="printerStatusPanel" class="printer-status-panel" aria-live="polite">
                                        <div class="text-muted">Checking printer status...</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="card">
                            <div class="card-header" id="headingLabelSize">
                                <h4 class="card-title">
                                    <button class="btn" data-bs-toggle="collapse" data-bs-target="#collapseLabelSize" aria-expanded="true" aria-controls="collapseLabelSize">
                                        <span class="bi-file-earmark-fill" aria-hidden="true"></span> Label Size
                                    </button>
                                </h4>
                            </div>
                            <div id="collapseLabelSize" class="collapse show" aria-labelledby="headingLabelSize" data-parent="#accordion">
                                <div class="chooser card-body">
                                    <label for="labelSize" style="display: none">Label Size:</label>
                                    <select class="form-control" id="labelSize" onChange="preview()">
                                            {% for label_size in label_sizes %}<option value="{{label_size[0]}}" {% if label.default_size == label_size[0] %}selected{% endif %}>{{label_size[1]}}</option>{% endfor %}
                                        </select>
                                    <label for="orientation" style="margin-top: 10px; margin-bottom: 0">Label Orientation:</label>
                                    <div class="orientation-options" id="orientation">
                                        <label><input type="radio" onchange="preview()" name="orientation" value="standard" {% if default_orientation == 'standard' %}checked{% endif %}> Landscape</label>
                                        <label><input type="radio" onchange="preview()" name="orientation" value="rotated" {% if default_orientation == 'rotated' %}checked{% endif %}> Portrait</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title" id="headingFontSettings">
                                    <button class="btn" data-bs-toggle="collapse" data-bs-target="#collapseFontSettings" aria-expanded="true" aria-controls="collapseFontSettings">
                                        <span class="bi-fonts" aria-hidden="true"></span> Font Settings
                                    </button>
                                </h4>
                            </div>
                            <div id="collapseFontSettings" class="collapse show" aria-labelledby="headingFontSettings" data-parent="#accordion">
                                <div class="chooser card-body">
                                    <label for="fontFamilyFilter">Font Family:</label>
                                    <input id="fontFamilyFilter" class="form-control" type="search" placeholder="Filter families" onInput="filterFontFamilies()">
                                    <select class="form-control" id="fontFamilySelect" onChange="onFontFamilyChanged()"></select>
                                    <label for="fontStyleFilter">Font Style:</label>
                                    <input id="fontStyleFilter" class="form-control" type="search" placeholder="Filter styles" onInput="filterFontStyles()">
                                    <select class="form-control" id="fontStyleSelect" onChange="preview()"></select>
                                    <input type="hidden" id="fontFamily" value="{{ label.default_font.family }} ({{ label.default_font.style }})">
                                    <label for="fontSize">Font Size:</label>
                                    <input id="fontSize" class="form-control" type="number" min="1" value="{{ label.default_font_size }}" onChange="preview()" required>
                                    <label for="fontAlign" class="control-label input-group">Font Alignment:</label>
                                    <div class="btn-group" id="fontAlign" data-toggle="buttons">
                                        <label class="btn btn-default">
                                            <input type="radio" name="fontAlign" onchange="preview()" value="left" aria-label="Left Align"><span class="bi-text-left" aria-hidden="true"></span>
                                        </label>
                                        <label class="btn btn-default active">
                                            <input type="radio" name="fontAlign" onchange="preview()" value="center" aria-label="Center Align" checked=""><span class="bi-text-center" aria-hidden="true"></span>
                                        </label>
                                        <label class="btn btn-default">
                                            <input type="radio" name="fontAlign" onchange="preview()" value="right" aria-label="Right Align"><span class="bi-text-right" aria-hidden="true"></span>
                                        </label>
                                    </div>
                                    <label for="verticalAlign" class="control-label input-group">Vertical Alignment:</label>
                                    <div class="btn-group" id="verticalAlign" data-toggle="buttons">
                                        <label class="btn btn-default">
                                            <input type="radio" name="verticalAlign" onchange="preview()" value="top" aria-label="Top Align"><span class="bi-align-top" aria-hidden="true"></span>
                                        </label>
                                        <label class="btn btn-default active">
                                            <input type="radio" name="verticalAlign" onchange="preview()" value="center" aria-label="Middle Align" checked=""><span class="bi-align-middle" aria-hidden="true"></span>
                                        </label>
                                        <label class="btn btn-default">
                                            <input type="radio" name="verticalAlign" onchange="preview()" value="bottom" aria-label="Bottom Align"><span class="bi-align-bottom" aria-hidden="true"></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="card">
                            <div class="card-header" id="headingDetailedSettings">
                                <h4 class="card-title">
                                    <button class="btn" data-bs-toggle="collapse" data-bs-target="#collapseDetailedSettings" aria-expanded="false" aria-controls="collapseDetailedSettings">
                                        <span class="bi-gear-fill" aria-hidden="true"></span> Detailed Settings
                                    </button>
                                </h4>
                            </div>
                            <div id="collapseDetailedSettings" class="collapse" aria-labelledby="headingDetailedSettings" data-parent="#accordion">
                                <div class="chooser card-body">
                                    <label for="marginTop">Margin Top:</label>
                                    <div class="input-group marginsTopBottom">
                                        <input id="marginTop" class="form-control marginsTopBottom" type="number" min="0" max="200" value="24" onChange="preview()" required> <span class="input-group-addon">%</span>
                                    </div>
                                    <label for="marginBottom">Margin Bottom:</label>
                                    <div class="input-group marginsTopBottom">
                                        <input id="marginBottom" class="form-control marginsTopBottom" type="number" min="0" max="200" value="45" onChange="preview()" required> <span class="input-group-addon">%</span>
                                    </div>
                                    <label for="marginLeft">Margin Left:</label>
                                    <div class="input-group marginsLeftRight">
                                        <input id="marginLeft" class="form-control marginsLeftRight" type="number" min="0" max="200" value="35" onChange="preview()" required> <span class="input-group-addon">%</span>
                                    </div>
                                    <label for="marginRight">Margin Right:</label>
                                    <div class="input-group marginsLeftRight">
                                        <input id="marginRight" class="form-control marginsLeftRight" type="number" min="0" max="200" value="35" onChange="preview()" required> <span class="input-group-addon">%</span>
                                    </div>
                                    <label class="btn" style="margin-top: 10px;">
                                        <input type="checkbox" name="dateStamp" id="dateStamp" onchange="preview()" aria-label="Date Stamp"> Date Stamp
                                    </label>
                                    <label for="dateStampHorizontal">Date Horizontal:</label>
                                    <select class="form-control" id="dateStampHorizontal" onChange="preview()">
                                        <option value="left">Left</option>
                                        <option value="right" selected>Right</option>
                                    </select>
                                    <label for="dateStampVertical">Date Vertical:</label>
                                    <select class="form-control" id="dateStampVertical" onChange="preview()">
                                        <option value="top">Top</option>
                                        <option value="bottom" selected>Bottom</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header" id="headingAmount">
                            <h4 class="card-title">
                                <button class="btn" data-bs-toggle="collapse" data-bs-target="#collapseAmount" aria-expanded="false" aria-controls="collapseAmount">
                                    <span class="bi-repeat" aria-hidden="true"></span> Amount
                                </button>
                            </h4>
                        </div>
                        <div id="collapseAmount" class="collapse" aria-labelledby="headingAmount" data-parent="#accordion">
                            <div class="chooser card-body">
                                <label for="labelCount">Label Count:</label>
                                <div class="input-group labelCount">
                                    <input id="labelCount" class="form-control" type="number" min="1" max="200" value="1" onChange="preview()" required>
                                </div>
                                <label for="cutMode" style="margin-top: 10px;">Cut:</label>
                                <select class="form-control" id="cutMode" onChange="preview()">
                                    <option value="each" selected>After each label</option>
                                    <option value="last">After last label</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header" id="headingQuality">
                            <h4 class="card-title">
                                <button class="btn" data-bs-toggle="collapse" data-bs-target="#collapseQuality" aria-expanded="false" aria-controls="collapseQuality">
                                    <span class="bi-badge-hd-fill" aria-hidden="true"></span> Quality
                                </button>
                            </h4>
                        </div>
                        <div id="collapseQuality" class="collapse" aria-labelledby="headingQuality" data-parent="#accordion">
                            <div class="chooser card-body">
                                <label class="btn">
                                    <input type="checkbox" name="highQuality" id="highQuality" onchange="preview()" aria-label="High Quality" checked="checked"> High Quality
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            </fieldset>
        </div>
        <div class="col-md-4">
            <fieldset class="form-group">
                <label for="labelText">Label Text:</label>
                <textarea rows="7" id="labelText" class="form-control" onChange="preview()" onInput="preview()"></textarea>
            </fieldset>
        </div>
        <div class="col-md-4">
            <fieldset class="form-group">
                <label for="previewImg">Label Preview:</label><br />
                <img id="previewImg" style="border: 1px solid #444; max-height: 350px; width: auto; max-width: 100%; margin-bottom: 10px;" />
                <p>Printed size w/o margins: <span id="labelWidth">?</span> cm x <span id="labelHeight">?</span> cm<span id="labelPages"></span></p>
                <button id="printButton" type="button" class="btn btn-primary btn-block btn-lg" onClick="print()">
              <span class="bi-printer-fill" aria-hidden="true"></span> Print
            </button>
            </fieldset>
            <div class="card card-default">
                <div class="card-header">
                    <h3 class="card-title"><span class="bi-journal" aria-hidden="true" style="margin-right: 0.3em"></span> Status</h3>
                </div>
                <div id="statusPanel" class="card-body">
                    - undefined -
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascript %}
    let PRINTERS = {{ printers_json | safe }};
    const FONTS = {{ fonts | tojson }};
    const DEFAULT_FONT_FAMILY = {{ label.default_font.family | tojson }};
    const DEFAULT_FONT_STYLE = {{ label.default_font.style | tojson }};
    const DEFAULT_LABEL_SIZE = {{ label.default_size | tojson }};
    const SETTINGS_KEY = 'brother_ql_web.labeldesigner.settings';
    let currentPrinterStatus = null;
    let printerStatusTimer = null;

    function getValue(id) {
        return document.getElementById(id).value;
    }

    function getSelectedOption(id) {
        const selection = document.getElementById(id);
        if (selection.selectedIndex < 0) {
            return '';
        }
        return selection.options[selection.selectedIndex].value;
    }

    function getSelectedRadioButton(name, fallback) {
        const selector = document.querySelector('input[name="' + name + '"]:checked');
        if (!selector) {
            return fallback;
        }
        return selector.value;
    }

    function isChecked(id) {
        return document.getElementById(id).checked;
    }

    function getPrinter() {
        const printerId = getSelectedOption('printerSelect');
        return PRINTERS.find(function(printer) { return printer.id === printerId; }) || PRINTERS[0];
    }

    function getSelectedLabelSize() {
        const printer = getPrinter();
        const labelSize = getSelectedOption('labelSize');
        if (!printer) {
            return null;
        }
        return printer.label_sizes.find(function(size) { return size.id === labelSize; }) || null;
    }

    function parseFontSelection(value) {
        const match = /^(.*) \((.*)\)$/.exec(value || '');
        if (!match) {
            return { family: DEFAULT_FONT_FAMILY, style: DEFAULT_FONT_STYLE };
        }
        return { family: match[1], style: match[2] };
    }

    function getFontSelection() {
        return {
            family: getSelectedOption('fontFamilySelect'),
            style: getSelectedOption('fontStyleSelect')
        };
    }

    function setFontSelection(family, style) {
        if (!FONTS[family]) {
            family = DEFAULT_FONT_FAMILY;
        }
        populateFontFamilies(family);
        if (!FONTS[family][style]) {
            style = Object.keys(FONTS[family]).sort()[0];
        }
        populateFontStyles(family, style);
        updateFontFamilyValue();
    }

    function updateFontFamilyValue() {
        const selection = getFontSelection();
        document.getElementById('fontFamily').value = selection.family + ' (' + selection.style + ')';
    }

    function populateFontFamilies(selectedFamily) {
        const familySelect = document.getElementById('fontFamilySelect');
        const filter = getValue('fontFamilyFilter').toLowerCase();
        const families = Object.keys(FONTS).sort().filter(function(family) {
            return !filter || family.toLowerCase().includes(filter);
        });
        familySelect.replaceChildren();
        for (const family of families) {
            const option = document.createElement('option');
            option.value = family;
            option.textContent = family;
            option.selected = family === selectedFamily;
            familySelect.appendChild(option);
        }
        if (familySelect.selectedIndex < 0 && familySelect.options.length > 0) {
            familySelect.selectedIndex = 0;
        }
    }

    function populateFontStyles(family, selectedStyle) {
        const styleSelect = document.getElementById('fontStyleSelect');
        const filter = getValue('fontStyleFilter').toLowerCase();
        const styles = Object.keys(FONTS[family] || {}).sort().filter(function(style) {
            return !filter || style.toLowerCase().includes(filter);
        });
        styleSelect.replaceChildren();
        for (const style of styles) {
            const option = document.createElement('option');
            option.value = style;
            option.textContent = style;
            option.selected = style === selectedStyle;
            styleSelect.appendChild(option);
        }
        if (styleSelect.selectedIndex < 0 && styleSelect.options.length > 0) {
            styleSelect.selectedIndex = 0;
        }
    }

    function filterFontFamilies() {
        const selection = getFontSelection();
        populateFontFamilies(selection.family);
        if (!getSelectedOption('fontFamilySelect')) {
            setFontSelection(DEFAULT_FONT_FAMILY, DEFAULT_FONT_STYLE);
            return;
        }
        onFontFamilyChanged();
    }

    function filterFontStyles() {
        const selection = getFontSelection();
        populateFontStyles(selection.family, selection.style);
        updateFontFamilyValue();
        preview();
    }

    function onFontFamilyChanged() {
        const family = getSelectedOption('fontFamilySelect') || DEFAULT_FONT_FAMILY;
        populateFontStyles(family, '');
        updateFontFamilyValue();
        preview();
    }

    function getSavedSettings() {
        try {
            return JSON.parse(localStorage.getItem(SETTINGS_KEY)) || {};
        } catch (e) {
            return {};
        }
    }

    function saveSettings() {
        updateFontFamilyValue();
        const settings = {
            printer_id: getSelectedOption('printerSelect'),
            label_size: getSelectedOption('labelSize'),
            font_family: getValue('fontFamily'),
            font_size: getValue('fontSize'),
            align: getSelectedRadioButton('fontAlign', 'center'),
            vertical_align: getSelectedRadioButton('verticalAlign', 'center'),
            orientation: getSelectedRadioButton('orientation', 'standard'),
            margin_top: getValue('marginTop'),
            margin_bottom: getValue('marginBottom'),
            margin_left: getValue('marginLeft'),
            margin_right: getValue('marginRight'),
            label_count: getValue('labelCount'),
            cut_mode: getSelectedOption('cutMode'),
            date_stamp: isChecked('dateStamp'),
            date_stamp_horizontal: getSelectedOption('dateStampHorizontal'),
            date_stamp_vertical: getSelectedOption('dateStampVertical'),
            high_quality: isChecked('highQuality'),
            text: getValue('labelText')
        };
        localStorage.setItem(SETTINGS_KEY, JSON.stringify(settings));
    }

    function setRadioButton(name, value) {
        const selector = document.querySelector('input[name="' + name + '"][value="' + value + '"]');
        if (selector) {
            selector.checked = true;
        }
        updateRadioButtonGroup(name);
    }

    function updateRadioButtonGroup(name) {
        const buttons = document.querySelectorAll('input[name="' + name + '"]');
        for (const button of buttons) {
            const label = button.closest('label');
            if (!label) {
                continue;
            }
            if (button.checked) {
                label.classList.add('active');
            } else {
                label.classList.remove('active');
            }
        }
    }

    function updateRadioButtonGroups() {
        updateRadioButtonGroup('fontAlign');
        updateRadioButtonGroup('verticalAlign');
        updateRadioButtonGroup('orientation');
    }

    function setRadioButtonGroupEnabled(name, enabled) {
        const buttons = document.querySelectorAll('input[name="' + name + '"]');
        for (const button of buttons) {
            const label = button.closest('label');
            button.disabled = !enabled;
            if (label) {
                label.classList.toggle('disabled', !enabled);
            }
        }
    }

    function updateContinuousRollControls() {
        const selectedLabelSize = getSelectedLabelSize();
        const orientation = getSelectedRadioButton('orientation', 'standard');
        const loaded = currentPrinterStatus && currentPrinterStatus.media_label_size;
        const continuous = Boolean(loaded && selectedLabelSize && selectedLabelSize.continuous);
        const horizontalEnabled = true;
        const verticalEnabled = !(continuous && orientation === 'standard');

        if (!verticalEnabled) {
            setRadioButton('verticalAlign', 'top');
        }
        setRadioButtonGroupEnabled('fontAlign', horizontalEnabled);
        setRadioButtonGroupEnabled('verticalAlign', verticalEnabled);
        updateRadioButtonGroups();
    }

    function setInputValue(id, value) {
        if (value !== undefined && value !== null) {
            document.getElementById(id).value = value;
        }
    }

    function restoreSettings() {
        const settings = getSavedSettings();
        if (settings.printer_id) {
            const printerSelect = document.getElementById('printerSelect');
            for (const option of printerSelect.options) {
                if (option.value === settings.printer_id) {
                    printerSelect.value = settings.printer_id;
                    break;
                }
            }
        }
        const fontSelection = parseFontSelection(settings.font_family);
        setFontSelection(fontSelection.family, fontSelection.style);
        setInputValue('fontSize', settings.font_size);
        setRadioButton('fontAlign', settings.align);
        setRadioButton('verticalAlign', settings.vertical_align);
        setRadioButton('orientation', settings.orientation);
        setInputValue('marginTop', settings.margin_top);
        setInputValue('marginBottom', settings.margin_bottom);
        setInputValue('marginLeft', settings.margin_left);
        setInputValue('marginRight', settings.margin_right);
        setInputValue('labelCount', settings.label_count);
        setInputValue('cutMode', settings.cut_mode);
        setInputValue('dateStampHorizontal', settings.date_stamp_horizontal);
        setInputValue('dateStampVertical', settings.date_stamp_vertical);
        setInputValue('labelText', settings.text);
        if (settings.date_stamp !== undefined) {
            document.getElementById('dateStamp').checked = Boolean(settings.date_stamp);
        }
        if (settings.high_quality !== undefined) {
            document.getElementById('highQuality').checked = Boolean(settings.high_quality);
        }
        resizeTextBox();
    }

    function syncTextBoxAlignment() {
        const textBox = document.getElementById('labelText');
        const horizontal = getSelectedRadioButton('fontAlign', 'center');
        const vertical = getSelectedRadioButton('verticalAlign', 'center');

        textBox.style.textAlign = horizontal;
        textBox.style.paddingTop = '';
        textBox.style.paddingBottom = '';

        const style = window.getComputedStyle(textBox);
        const basePaddingTop = parseFloat(style.getPropertyValue('padding-top')) || 0;
        const basePaddingBottom = parseFloat(style.getPropertyValue('padding-bottom')) || 0;
        const contentHeight = measureTextBoxContentHeight(textBox, style);
        const availableExtra = Math.max(
            textBox.clientHeight - basePaddingTop - basePaddingBottom - contentHeight,
            0
        );
        if (vertical === 'bottom') {
            textBox.style.paddingTop = (basePaddingTop + availableExtra) + 'px';
            textBox.style.paddingBottom = basePaddingBottom + 'px';
        } else if (vertical === 'center') {
            textBox.style.paddingTop = (basePaddingTop + availableExtra / 2) + 'px';
            textBox.style.paddingBottom = (basePaddingBottom + availableExtra / 2) + 'px';
        }
    }

    function measureTextBoxContentHeight(textBox, style) {
        const mirror = document.createElement('div');
        mirror.style.position = 'absolute';
        mirror.style.visibility = 'hidden';
        mirror.style.whiteSpace = 'pre-wrap';
        mirror.style.overflowWrap = 'break-word';
        mirror.style.boxSizing = 'border-box';
        mirror.style.width = textBox.clientWidth + 'px';
        mirror.style.fontFamily = style.getPropertyValue('font-family');
        mirror.style.fontSize = style.getPropertyValue('font-size');
        mirror.style.fontWeight = style.getPropertyValue('font-weight');
        mirror.style.fontStyle = style.getPropertyValue('font-style');
        mirror.style.lineHeight = style.getPropertyValue('line-height');
        mirror.style.letterSpacing = style.getPropertyValue('letter-spacing');
        mirror.style.padding = '0';
        mirror.style.border = '0';
        mirror.textContent = textBox.value || ' ';
        document.body.appendChild(mirror);
        const height = mirror.scrollHeight;
        mirror.remove();
        return height;
    }

    function resizeTextBox() {
        const textBox = document.getElementById('labelText');
        textBox.style.paddingTop = '';
        textBox.style.paddingBottom = '';
        textBox.style.height = 'auto';
        textBox.style.height = Math.max(textBox.scrollHeight, 160) + 'px';
        syncTextBoxAlignment();
    }

    function populateLabelSizes(preferredLabelSize) {
        const printer = getPrinter();
        const labelSize = document.getElementById('labelSize');
        const previous = preferredLabelSize || labelSize.value || DEFAULT_LABEL_SIZE;
        const loaded = currentPrinterStatus && currentPrinterStatus.media_label_size;
        const selected = loaded || previous;
        if (!printer) {
            return false;
        }
        labelSize.replaceChildren();

        for (const size of printer.label_sizes) {
            const option = document.createElement('option');
            option.value = size.id;
            option.textContent = size.name;
            if (loaded && loaded === size.id) {
                option.textContent += ' (loaded)';
            }
            if (size.id === selected) {
                option.selected = true;
            }
            labelSize.appendChild(option);
        }

        if (labelSize.selectedIndex < 0 && labelSize.options.length > 0) {
            labelSize.selectedIndex = 0;
        }
        return labelSize.value !== previous;
    }

    function renderPrinterStatus(status) {
        currentPrinterStatus = status;
        const panel = document.getElementById('printerStatusPanel');
        panel.replaceChildren();

        const box = document.createElement('div');
        box.className = status.ok ? 'alert alert-success' : 'alert alert-warning';

        const icon = document.createElement('i');
        icon.className = status.ok ? 'bi-check-square' : 'bi-exclamation-triangle-fill';
        box.appendChild(icon);

        const text = document.createElement('span');
        const lines = [];
        lines.push(status.status || 'UNKNOWN');
        if (status.media) {
            lines.push('Media: ' + status.media);
        }
        if (status.page_count) {
            lines.push('Page count: ' + status.page_count);
        }
        if (status.error) {
            lines.push(status.error);
        }
        text.textContent = lines.join(' | ');
        box.appendChild(text);
        panel.appendChild(box);
    }

    function renderNoPrinters() {
        currentPrinterStatus = null;
        const panel = document.getElementById('printerStatusPanel');
        panel.replaceChildren();
        const box = document.createElement('div');
        box.className = 'alert alert-warning';
        const icon = document.createElement('i');
        icon.className = 'bi-exclamation-triangle-fill';
        box.appendChild(icon);
        const text = document.createElement('span');
        text.textContent = 'No printers discovered';
        box.appendChild(text);
        panel.appendChild(box);
    }

    function populatePrinters(printers, preferredPrinterId) {
        PRINTERS = printers;
        const printerSelect = document.getElementById('printerSelect');
        const previous = preferredPrinterId || printerSelect.value;
        printerSelect.replaceChildren();
        for (const printer of PRINTERS) {
            const option = document.createElement('option');
            option.value = printer.id;
            option.textContent = printer.name;
            option.selected = printer.id === previous;
            printerSelect.appendChild(option);
        }
        if (printerSelect.selectedIndex < 0 && printerSelect.options.length > 0) {
            printerSelect.selectedIndex = 0;
        }
        return printerSelect.value !== previous;
    }

    function refreshPrinters() {
        const request = new XMLHttpRequest();
        request.addEventListener('load', function() {
            const response = JSON.parse(this.response);
            const changedPrinter = populatePrinters(response.printers, getSelectedOption('printerSelect'));
            if (response.printers.length === 0) {
                renderNoPrinters();
                saveSettings();
                return;
            }
            const selectedPrinter = getSelectedOption('printerSelect');
            const printer = response.printers.find(function(item) {
                return item.id === selectedPrinter;
            });
            if (printer) {
                renderPrinterStatus(printer.status);
                const changed = populateLabelSizes();
                updateContinuousRollControls();
                saveSettings();
                if (changed || changedPrinter) {
                    preview();
                }
            }
        });
        request.open('GET', '/api/printers');
        request.send();
    }

    function onPrinterChanged() {
        currentPrinterStatus = null;
        populateLabelSizes(getSavedSettings().label_size);
        const printer = getPrinter();
        if (printer && printer.status) {
            renderPrinterStatus(printer.status);
        }
        saveSettings();
        refreshPrinters();
        preview();
    }

    function formData() {
        var text = getValue('labelText');
        if (text == '') {
            text = ' ';
        }
        updateFontFamilyValue();
        const fontFamily = getValue('fontFamily');
        const fontSize = getValue('fontSize');
        const labelSize = getSelectedOption('labelSize');
        const align = getSelectedRadioButton('fontAlign', 'center');
        const verticalAlign = getSelectedRadioButton('verticalAlign', 'center');
        const orientation = getSelectedRadioButton('orientation', 'standard');
        const marginTop = getValue('marginTop');
        const marginBottom = getValue('marginBottom');
        const marginLeft = getValue('marginLeft');
        const marginRight = getValue('marginRight');
        const labelCount = getValue('labelCount');
        const cutMode = getSelectedOption('cutMode');
        const dateStamp = isChecked('dateStamp');
        const dateStampHorizontal = getSelectedOption('dateStampHorizontal');
        const dateStampVertical = getSelectedOption('dateStampVertical');
        const highQuality = isChecked('highQuality');
        const printerId = getSelectedOption('printerSelect');

        const data = new FormData();
        data.append('printer_id', printerId);
        data.append('text', text);
        data.append('font_family', fontFamily);
        data.append('font_size', fontSize);
        data.append('label_size', labelSize);
        data.append('align', align);
        data.append('vertical_align', verticalAlign);
        data.append('orientation', orientation);
        data.append('margin_top', marginTop);
        data.append('margin_bottom', marginBottom);
        data.append('margin_left', marginLeft);
        data.append('margin_right', marginRight);
        data.append('label_count', labelCount);
        data.append('cut_mode', cutMode);
        data.append('date_stamp', dateStamp);
        data.append('date_stamp_horizontal', dateStampHorizontal);
        data.append('date_stamp_vertical', dateStampVertical);
        data.append('high_quality', highQuality);
        return data;
    }

    function setPreviewImage(response) {
        const img = document.getElementById('previewImg');
        const labelWidth = response.getResponseHeader('X-Label-Width');
        const labelHeight = response.getResponseHeader('X-Label-Height');
        const labelPages = parseInt(response.getResponseHeader('X-Label-Pages') || '1', 10);
        img.setAttribute('src', 'data:image/png;base64,' + response.response);
        img.onload = function() {
            const width = labelWidth || img.naturalWidth;
            const height = labelHeight || img.naturalHeight;
            document.getElementById('labelWidth').innerHTML = (width / 300 * 2.54).toFixed(1);
            document.getElementById('labelHeight').innerHTML = (height / 300 * 2.54).toFixed(1);
            document.getElementById('labelPages').innerHTML = labelPages > 1 ? ' x ' + labelPages + ' pages' : '';
        };
    }

    function preview() {
        updateContinuousRollControls();
        resizeTextBox();
        saveSettings();

        const request = new XMLHttpRequest();
        request.addEventListener('load', function() {
            setPreviewImage(this);
        });
        request.open('POST', '/api/preview/text?return_format=base64');
        request.setRequestHeader('Accept', 'application/x-www-form-urlencoded; charset=UTF-8');
        request.send(formData());
    }

    function setStatus(data) {
        if (data.success) {
            const message = data.message || 'Printing was sent.';
            document.getElementById('statusPanel').innerHTML = '<div id="statusBox" class="alert alert-success" role="alert"><i class="bi-check-square"></i><span>' + message + '</span></div>';
        } else {
            /* TODO: https://developer.mozilla.org/en-US/docs/Web/API/Element/setHTML#browser_compatibility */
            document.getElementById('statusPanel').innerHTML = '<div id="statusBox" class="alert alert-warning" role="alert"><i class="bi-exclamation-triangle-fill"></i><span>Printing was unsuccessful:<br />' + data.message + '</span></div>';
        }
        document.getElementById('printButton').removeAttribute('disabled');
    }

    function print() {
        saveSettings();
        document.getElementById('printButton').setAttribute('disabled', true);
        document.getElementById('statusPanel').innerHTML = '<div id="statusBox" class="alert alert-info" role="alert"><i class="bi-hourglass"></i><span>Waiting for printer...</span></div>';

        const request = new XMLHttpRequest();
        request.addEventListener('load', function() {
            setStatus(JSON.parse(this.response));
        });
        request.addEventListener('error', function() {
            setStatus(JSON.parse(this.response));
        });
        request.open('POST', '/api/print/text');
        request.setRequestHeader('Accept', 'application/x-www-form-urlencoded; charset=UTF-8');
        request.send(formData());
    }

    setFontSelection(DEFAULT_FONT_FAMILY, DEFAULT_FONT_STYLE);
    restoreSettings();
    updateRadioButtonGroups();
    populatePrinters(PRINTERS, getSavedSettings().printer_id);
    populateLabelSizes(getSavedSettings().label_size);
    if (getPrinter() && getPrinter().status) {
        renderPrinterStatus(getPrinter().status);
    } else if (!getPrinter()) {
        renderNoPrinters();
    }
    refreshPrinters();
    printerStatusTimer = window.setInterval(refreshPrinters, 2000);
    preview();

{% endblock %}
